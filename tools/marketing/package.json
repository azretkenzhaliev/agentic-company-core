{
  "name": "agentic-company-marketing-tools",
  "private": true,
  "description": "Renderer for the marketing department: HTML/CSS to PNG (Playwright), motion reels (Remotion), subtitles (ffmpeg). See README.md.",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "png": "node render/png.mjs",
    "reel": "node render/reel.mjs",
    "subtitles": "node video/subtitles.mjs"
  },
  "dependencies": {
    "@fontsource/golos-text": "5.3.0",
    "@fontsource/montserrat": "5.3.0",
    "@fontsource/scheherazade-new": "5.3.0",
    "@remotion/bundler": "4.0.535",
    "@remotion/cli": "4.0.535",
    "@remotion/renderer": "4.0.535",
    "ffmpeg-static": "5.3.0",
    "playwright": "1.64.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.535"
  }
}
