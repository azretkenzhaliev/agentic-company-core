{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "agent": "ceo",
  "env": {
    "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS": "30",
    "SECOND_OPINION_OPENAI_TIER": "flex"
  },
  "permissions": {
    "deny": [
      "Bash(git push *--force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Bash(git -C * push *--force*)",
      "Bash(git -C * push -f*)",
      "Bash(git -C * push * -f*)",
      "Bash(git -C * push * +*)",
      "Bash(gh pr merge *--admin*)",
      "Bash(gh pr merge *--auto*)",
      "Bash(gemini *)",
      "mcp__claude_ai_Neon__delete_project",
      "mcp__claude_ai_Neon__delete_branch",
      "mcp__claude_ai_Neon__reset_from_parent",
      "mcp__claude_ai_Neon__restore_snapshot",
      "mcp__claude_ai_Neon__finalize_branch_restore",
      "mcp__claude_ai_Neon__delete_snapshot",
      "mcp__claude_ai_Neon__set_snapshot_schedule",
      "mcp__claude_ai_Neon__delete_postgres_database",
      "mcp__claude_ai_Neon__delete_postgres_endpoint",
      "mcp__claude_ai_Neon__delete_postgres_role"
    ],
    "allow": [
      "Bash(python3 scripts/kb_lint.py *)",
      "Bash(python3 -m unittest *)",
      "Bash(git status *)",
      "Bash(git branch *)",
      "Bash(git rev-parse *)",
      "Bash(git worktree list *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "Bash(gh repo view *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(npm test *)",
      "Bash(npm run test *)",
      "Bash(npm run lint *)",
      "Bash(npm run typecheck *)",
      "Bash(pnpm test *)",
      "Bash(pnpm run test *)",
      "Bash(yarn test *)",
      "Bash(pytest *)",
      "Bash(python3 -m pytest *)",
      "Bash(bun run test *)",
      "Bash(bun run lint *)",
      "Bash(bun run e2e *)",
      "Bash(bunx tsc --noEmit *)",
      "Bash(npm run check *)",
      "Bash(npx eslint *)",
      "Bash(npx tsc --noEmit *)",
      "Bash(python3 scripts/second_opinion.py *)",
      "mcp__claude_ai_Neon__list_projects",
      "mcp__claude_ai_Neon__describe_project",
      "mcp__claude_ai_Neon__list_branches",
      "mcp__claude_ai_Neon__get_branch",
      "mcp__claude_ai_Neon__get_default_branch",
      "mcp__claude_ai_Neon__describe_branch",
      "mcp__claude_ai_Neon__list_postgres_databases",
      "mcp__claude_ai_Neon__get_database_tables",
      "mcp__claude_ai_Neon__describe_table_schema",
      "mcp__claude_ai_Neon__compare_database_schema",
      "mcp__claude_ai_Neon__list_organizations",
      "mcp__claude_ai_Neon__list_postgres_roles",
      "mcp__claude_ai_Neon__list_snapshots",
      "mcp__claude_ai_Neon__get_snapshot_schedule",
      "mcp__claude_ai_Neon__list_operations",
      "mcp__claude_ai_Neon__get_operation",
      "mcp__claude_ai_Neon__inspect_database",
      "mcp__claude_ai_Neon__list_docs_resources",
      "mcp__claude_ai_Neon__get_doc_resource",
      "mcp__claude_ai_Neon__create_branch",
      "mcp__claude_ai_Neon__run_sql",
      "mcp__claude_ai_Neon__run_sql_transaction"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/scripts/hooks/guard_kb_write.py",
            "args": [],
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/scripts/hooks/guard_agent_spawn.py",
            "args": [],
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "SendMessage|TaskStop",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/scripts/hooks/guard_agent_control.py",
            "args": [],
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/scripts/hooks/guard_marketing_tools.py",
            "args": [],
            "timeout": 60,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "mcp__.*[Nn][Ee][Oo][Nn].*__run_sql.*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/scripts/hooks/guard_neon_sql.py",
            "args": [],
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/scripts/hooks/approve_git_reads.py",
            "args": [],
            "timeout": 10
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/scripts/hooks/approve_worktree_merge.py",
            "args": [],
            "timeout": 10
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/scripts/hooks/approve_pr_ready.py",
            "args": [],
            "timeout": 10
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/scripts/hooks/guard_kb_write.py",
            "args": [],
            "timeout": 10,
            "onFailure": "block"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/scripts/hooks/guard_vercel_cli.py",
            "args": [],
            "timeout": 10,
            "onFailure": "block"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/scripts/hooks/guard_critic_bash.py",
            "args": [],
            "timeout": 10,
            "onFailure": "block"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/scripts/hooks/guard_marketing_tools.py",
            "args": [],
            "timeout": 60,
            "onFailure": "block"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/scripts/hooks/guard_full_suite.py",
            "args": [],
            "timeout": 40,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__.*notion-query-data-sources",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/scripts/notion_approvals_sync.py",
            "args": [],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
